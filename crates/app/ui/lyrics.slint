// Synced lyrics: the song's lines follow the playback, the current one in the upper third, its
// words filling in as they are sung. Only the current line reads the clock, so the rest of the
// screen is not redrawn while it plays.
import { Fonts } from "theme.slint";

// start/end in ms of the song.
export struct LyricWord { text: string, start: int, end: int }
// start: -1 for unsynced lyrics; next: when the following line starts.
export struct LyricRow { text: string, start: int, next: int, words: [LyricWord] }

component Word inherits Rectangle {
    in property <LyricWord> word;
    in property <bool> active;
    in property <int> now;
    in property <length> size;
    // 0 → 1 while the word is sung.
    property <float> fill: root.active
        ? max(0, min(1, (root.now - root.word.start) / max(1, root.word.end - root.word.start)))
        : 0;
    // The word being sung rises a little.
    property <bool> singing: root.fill > 0 && root.fill < 1;
    width: base.preferred-width;
    height: base.preferred-height;
    lift := Rectangle {
        y: root.singing ? -3px : 0px;
        animate y { duration: 220ms; easing: ease-out; }
        base := Text {
            x: 0;
            y: 0;
            text: root.word.text;
            font-family: Fonts.display;
            font-weight: 700;
            font-size: root.size;
            color: root.active ? #FFFFFF59 : #FFFFFF;
            animate color { duration: 350ms; }
        }
        if root.active: Rectangle {
            x: 0;
            y: 0;
            width: base.width * root.fill;
            height: base.height;
            clip: true;
            Text {
                x: 0;
                y: 0;
                width: base.width;
                text: root.word.text;
                font-family: Fonts.display;
                font-weight: 700;
                font-size: root.size;
                color: #FFFFFF;
            }
        }
    }
}

component Line inherits Rectangle {
    in property <LyricRow> line;
    in property <bool> active;
    in property <bool> past;
    in property <int> now;
    in property <length> size;
    callback clicked();
    // Lines further from the current one fade out.
    opacity: root.active ? 1 : root.past ? 0.38 : 0.5;
    animate opacity { duration: 450ms; easing: ease-out; }
    min-height: root.line.words.length == 0 && root.line.text == "" ? 8px : 0px;
    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        // The current line steps in a little.
        padding-left: root.active ? 10px : 0px;
        animate padding-left { duration: 500ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        if root.line.words.length > 0: FlexboxLayout {
            spacing-horizontal: root.size * 0.28;
            spacing-vertical: 2px;
            for w in root.line.words: Word {
                word: w;
                active: root.active;
                now: root.now;
                size: root.size;
            }
        }
        if root.line.words.length == 0 && root.line.text != "": Text {
            text: root.line.text;
            font-family: Fonts.display;
            font-weight: 700;
            font-size: root.size;
            color: #FFFFFF;
            wrap: word-wrap;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LyricsView inherits Rectangle {
    in property <[LyricRow]> lines;
    in property <int> position-ms;
    in property <bool> playing;
    in property <length> size: 30px;
    callback seek-to(int);

    // The song's clock, run on between the player's position reports (a few a second) from the
    // time that really passed: a busy frame delays a step, it does not slow the song down.
    property <int> now: root.position-ms;
    property <int> base-pos: root.position-ms;
    property <duration> base-tick;
    // A line shows a little early: reading lags behind hearing.
    property <int> lead: 150;
    function anchor(ms: int) {
        root.base-pos = ms;
        root.base-tick = animation-tick();
        root.now = ms;
    }
    init => { root.anchor(root.position-ms); }
    changed position-ms => {
        // Small corrections backwards are skipped so the fill never jerks back.
        if root.position-ms > root.now || root.position-ms < root.now - 400 {
            root.anchor(root.position-ms);
        }
    }
    changed playing => { root.anchor(root.now); }
    Timer {
        interval: 33ms;
        running: root.playing;
        triggered => {
            root.now = root.base-pos + round((animation-tick() - root.base-tick) / 1ms);
        }
    }

    property <length> focus-y: 0;
    lyr := Flickable {
        interactive: false;
        content-height: col.preferred-height + root.height;
        content-y: min(0px, -(root.focus-y - root.height * 0.36));
        animate content-y { duration: 700ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
        col := VerticalLayout {
            width: lyr.width;
            padding-top: 24px;
            alignment: start;
            for l[i] in root.lines: Line {
                property <bool> current: root.now + root.lead >= l.start && root.now + root.lead < l.next;
                line: l;
                active: self.current;
                past: root.now + root.lead >= l.next;
                now: root.now;
                size: root.size;
                init => {
                    if self.current { root.focus-y = self.y + self.height / 2; }
                }
                changed current => {
                    if self.current { root.focus-y = self.y + self.height / 2; }
                }
                changed y => {
                    if self.current { root.focus-y = self.y + self.height / 2; }
                }
                clicked => { root.seek-to(l.start); }
            }
        }
    }
}
