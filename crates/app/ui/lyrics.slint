// Synced lyrics: the current line stays centered, with two nearby lines on either side.
import { Fonts } from "theme.slint";

// start/end in ms of the song.
export struct LyricWord { text: string, start: int, end: int }
// start: -1 for unsynced lyrics; next: when the following line starts.
export struct LyricRow { text: string, start: int, next: int, words: [LyricWord] }

component Word inherits Rectangle {
    in property <string> text;
    // The word's line is the current one.
    in property <bool> active;
    // Already sung (or being sung).
    in property <bool> lit;
    in property <length> size;
    width: base.preferred-width;
    height: base.preferred-height;
    base := Text {
        x: 0;
        y: 0;
        text: root.text;
        font-family: Fonts.display;
        font-weight: 700;
        font-size: root.size;
        color: !root.active || root.lit ? #FFFFFF : #FFFFFF59;
        animate font-size { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate color { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    }
}

component Line inherits Rectangle {
    in property <LyricRow> line;
    in property <bool> active;
    in property <int> distance;
    // Index of the word being sung in this line, -1 before the first.
    in property <int> word;
    in property <length> size;
    callback clicked();
    property <bool> hovered: row-touch.has-hover;
    background: root.hovered ? #FFFFFF18 : #00000000;
    animate background { duration: 160ms; easing: ease-out; }
    // Keep a clear five-line focus window; more distant lines recede into the background.
    property <length> display-size: root.distance == 0 ? root.size
        : root.distance == 1 ? root.size * 0.78
        : root.distance == 2 ? root.size * 0.66
        : root.size * 0.58;
    opacity: root.distance == 0 ? 1 : root.distance == 1 ? 0.68 : root.distance == 2 ? 0.38 : 0.10;
    animate opacity { duration: 520ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    min-height: root.line.words.length == 0 && root.line.text == "" ? 8px : 0px;
    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 6px;
        // Keep text geometry stable while focus moves; only colour and opacity ease between lines.
        padding-left: 0px;
        if root.line.words.length > 0: FlexboxLayout {
            spacing-horizontal: root.display-size * 0.22;
            spacing-vertical: 2px;
            for w[k] in root.line.words: Word {
                text: w.text;
                active: root.active;
                lit: k <= root.word;
                size: root.display-size;
            }
        }
        if root.line.words.length == 0 && root.line.text != "": Text {
            text: root.line.text;
            font-family: Fonts.display;
            font-weight: 700;
            font-size: root.display-size;
            color: #FFFFFF;
            wrap: word-wrap;
            animate font-size { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PlainLyricLine inherits Rectangle {
    in property <string> text;
    width: parent.width;
    height: label.preferred-height + 16px;
    background: row-touch.has-hover ? #FFFFFF18 : #00000000;
    animate background { duration: 160ms; easing: ease-out; }
    label := Text {
        x: 12px;
        y: 8px;
        width: root.width - 24px;
        text: root.text != "" ? root.text : " ";
        font-family: Fonts.display;
        font-weight: 700;
        font-size: 24px;
        color: #FFFFFFE0;
        wrap: word-wrap;
    }
    row-touch := TouchArea { }
}

export component LyricsView inherits Rectangle {
    in property <[LyricRow]> lines;
    // The current line and word, moved on by the app exactly when they change: nothing here
    // runs on a frame clock, so the screen stays still between words.
    in property <int> current-line: -1;
    in property <int> current-word: -1;
    in property <int> layout-mode: 0; // scrolling list | centered five-line focus
    in property <length> size: 48px;
    callback seek-to(int);

    property <length> focus-y: 0;
    property <int> focus-index: root.current-line < 0 ? 0 : root.current-line;
    lyr := Flickable {
        interactive: false;
        content-height: root.layout-mode == 1 ? max(root.height, col.preferred-height)
            : col.preferred-height + root.height;
        content-y: root.layout-mode == 1 ? 0px : min(0px, -(root.focus-y - root.height * 0.50));
        animate content-y { duration: 900ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        col := VerticalLayout {
            width: lyr.width;
            height: root.layout-mode == 1 ? max(root.height, self.preferred-height) : self.preferred-height;
            padding-top: root.layout-mode == 0 ? 24px : 0px;
            alignment: root.layout-mode == 1 ? center : start;
            for l[i] in root.lines: if root.layout-mode == 0 || abs(i - root.focus-index) <= 2: Line {
                property <bool> current: i == root.current-line;
                property <int> distance: abs(i - root.focus-index);
                line: l;
                active: self.current;
                distance: self.distance;
                word: self.current ? root.current-word : -1;
                size: root.layout-mode == 1 ? root.size * 1.16 : root.size;
                init => {
                    if self.current { root.focus-y = self.y + self.height / 2; }
                }
                changed current => {
                    if self.current { root.focus-y = self.y + self.height / 2; }
                }
                clicked => { root.seek-to(l.start); }
            }
        }
    }
}
