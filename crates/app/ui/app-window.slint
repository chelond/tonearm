// Tonearm UI. Presentation only: all data and actions go through properties and callbacks handled
// in Rust. Layout: sidebar · page · (queue) over the player bar; lyrics and the quick-jump palette
// are overlays.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Fonts, Layout, Caption, Heading, Icon, IconButton, PlayButton, Button, ButtonKind, Segmented, Toggle, Slider, Cover, Equalizer, TrackRow, RowState } from "theme.slint";
export { RowState, Theme }

export enum AuthView { checking, logged-out, waiting, connecting, reconnecting, logged-in }
export enum PlayView { stopped, loading, playing, paused }
export enum Page { home, search, library, settings, collection, stats }
// idle: nothing known yet; latest: checked, this is the newest; failed: check or install failed.
export enum UpdateState { idle, checking, latest, available, downloading, installing, failed }

export struct PlaylistEntry { uri: string, name: string, count: int, owner: string, image: image, has-image: bool }
// kind: 0 liked, 1 playlist, 2 album, 3 artist
export struct TileData { uri: string, kind: int, title: string, subtitle: string, image: image, has-image: bool }
export struct TrackData { code: string, title: string, artist: string, album: string, duration: string, state: RowState, image: image, has-image: bool }
export struct DeviceRow { id: string, name: string, kind: string, active: bool }
export struct QueueRow { code: string, title: string, artist: string, manual: bool }
export struct LyricRow { text: string }
// kind: 0 page, 1 playlist, 2 album, 3 artist, 4 search action, 5 liked, 6 command
export struct PaletteRow { kind: int, icon: string, title: string, subtitle: string, uri: string }
export struct ThemeCard { id: string, name: string, bg: color, surface: color, text: color, muted: color, accent: color, custom: bool }
export struct StatRow { title: string, subtitle: string, value: string, share: float, uri: string, image: image, has-image: bool }

export global Fmt {
    // "1:24"
    pure public function clock(ms: int) -> string {
        let total = floor(max(0, ms) / 1000);
        let m = floor(total / 60);
        let s = Math.mod(total, 60);
        return m + ":" + (s < 10 ? "0" : "") + s;
    }
}

// ───────────── small pieces ─────────────

// Fades and slides a page in when it is created (page switches).
component PageIn inherits Rectangle {
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: 260ms; easing: ease-out; }
    Rectangle {
        y: root.shown ? 0px : 14px;
        animate y { duration: 320ms; easing: ease-out; }
        width: root.width;
        height: root.height;
        @children
    }
}

component Logo inherits HorizontalLayout {
    spacing: 12px;
    alignment: start;
    VerticalLayout {
        alignment: center;
        Image {
            source: @image-url("../../../assets/icon-256.png");
            width: 30px;
            height: 30px;
        }
    }
    Text {
        text: "Tonearm";
        font-family: Fonts.display;
        font-weight: 700;
        font-size: 20px;
        color: Theme.text-1;
        vertical-alignment: center;
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-radius: 8px;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    // accent mark that grows on the open page
    Rectangle {
        x: 0;
        width: 3px;
        height: root.active ? 18px : 0px;
        y: (root.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 260ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
    }
    HorizontalLayout {
        padding-left: touch.has-hover && !root.active ? 16px : 12px;
        animate padding-left { duration: Theme.normal; easing: ease-out; }
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                name: root.icon;
                ink: root.active ? Theme.text-1 : Theme.text-2;
            }
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.text-1 : Theme.text-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Sidebar playlist with a small cover.
component SidebarRow inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <image> image;
    in property <bool> has-image;
    in property <bool> active;
    in property <bool> liked;
    in property <bool> playing;
    callback clicked();
    height: 52px;
    border-radius: 8px;
    background: root.active ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 12px;
        if root.liked: Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: @linear-gradient(135deg, #5B3CF0 0%, #C4B5FD 100%);
            Icon { name: "heart-fill"; size: 18px; ink: #FFFFFF; }
        }
        if !root.liked: Cover {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            source: root.image;
            loaded: root.has-image;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                font-size: 14px;
                color: root.playing ? Theme.accent : Theme.text-1;
                overflow: elide;
            }
            Text { text: root.sub; font-size: 12px; color: Theme.text-3; overflow: elide; }
        }
        if root.playing: VerticalLayout {
            alignment: center;
            Icon { name: "volume"; size: 14px; ink: Theme.accent; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Card with a cover; hover lifts it and shows a play button.
component TileView inherits Rectangle {
    in property <TileData> tile;
    in property <bool> round: tile.kind == 3;
    // Position in its grid: tiles fade up one after another.
    in property <int> index;
    callback clicked();
    callback play();
    property <bool> appeared: false;
    init => { self.appeared = true; }
    opacity: self.appeared ? 1 : 0;
    animate opacity { duration: 380ms; delay: min(root.index, 14) * 40ms; easing: ease-out; }
    border-radius: Layout.radius;
    background: touch.has-hover ? Theme.surface-2 : Theme.surface;
    animate background { duration: Theme.normal; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        y: root.appeared ? 0px : 18px;
        animate y { duration: 460ms; delay: min(root.index, 14) * 40ms; easing: ease-out; }
        padding: 12px;
        spacing: 10px;
        Rectangle {
            height: self.width;
            Cover {
                y: touch.has-hover ? -3px : 0px;
                animate y { duration: Theme.normal; easing: ease-out; }
                width: parent.width;
                height: parent.height;
                round: root.round;
                source: root.tile.image;
                loaded: root.tile.has-image;
                placeholder-icon: root.tile.kind == 3 ? "user" : root.tile.kind == 0 ? "heart" : "library";
            }
            if !root.round: PlayButton {
                size: 44px;
                x: parent.width - self.width - 8px;
                y: touch.has-hover ? parent.height - self.height - 8px : parent.height - self.height + 4px;
                opacity: touch.has-hover ? 1 : 0;
                animate y, opacity { duration: Theme.normal; easing: ease-out; }
                clicked => { root.play(); }
            }
        }
        Text { text: root.tile.title; font-size: 14px; font-weight: 600; color: Theme.text-1; overflow: elide; }
        Text {
            text: root.tile.subtitle;
            font-size: 12px;
            color: Theme.text-2;
            overflow: elide;
            horizontal-alignment: root.round ? center : left;
        }
    }
    @children
}

// Responsive grid of tiles: as many columns as fit (min tile width ~180 px).
component TileGrid inherits Rectangle {
    in property <[TileData]> tiles;
    in property <int> limit: 1000;
    in property <length> min-cell: 180px;
    callback open(int, string);
    callback play(int, string);
    out property <int> cols: max(2, floor((self.width + 16px) / (self.min-cell + 16px)));
    property <length> cell: (self.width - (self.cols - 1) * 16px) / self.cols;
    property <int> shown: min(self.limit, self.tiles.length);
    property <length> cell-h: self.cell + 52px;
    height: Math.ceil(self.shown / self.cols) * (self.cell-h + 16px);
    for t[i] in root.tiles: TileView {
        visible: i < root.limit;
        x: Math.mod(i, root.cols) * (root.cell + 16px);
        y: Math.floor(i / root.cols) * (root.cell-h + 16px);
        width: root.cell;
        height: root.cell-h;
        index: i;
        tile: t;
        clicked => { root.open(t.kind, t.uri); }
        play => { root.play(t.kind, t.uri); }
    }
}

// Compact quick-access card on the home page: small cover, name, play on hover.
component QuickCard inherits Rectangle {
    in property <PlaylistEntry> entry;
    in property <bool> liked;
    in property <bool> active;
    in property <int> index;
    callback clicked();
    callback play();
    property <bool> appeared: false;
    init => { self.appeared = true; }
    opacity: self.appeared ? 1 : 0;
    animate opacity { duration: 320ms; delay: min(root.index, 8) * 45ms; easing: ease-out; }
    height: 60px;
    border-radius: 8px;
    clip: true;
    background: touch.has-hover ? Theme.line-2 : Theme.hover;
    animate background { duration: Theme.normal; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 14px;
        padding-right: 10px;
        if root.liked: Rectangle {
            width: 60px;
            background: @linear-gradient(135deg, #5B3CF0 0%, #C4B5FD 100%);
            Icon { name: "heart-fill"; size: 22px; ink: #FFFFFF; }
        }
        if !root.liked: Cover { width: 60px; radius: 0px; source: root.entry.image; loaded: root.entry.has-image; }
        Text {
            text: root.entry.name;
            font-size: 14px;
            font-weight: 600;
            color: root.active ? Theme.accent : Theme.text-1;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        PlayButton {
            size: 36px;
            y: (parent.height - self.height) / 2;
            opacity: touch.has-hover ? 1 : 0;
            animate opacity { duration: Theme.normal; }
            clicked => { root.play(); }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 32px;
    width: tx.preferred-width + 28px;
    border-radius: 16px;
    background: root.active ? Theme.text-1 : t.has-hover ? Theme.line-2 : Theme.hover;
    animate background { duration: Theme.fast; }
    tx := Text {
        text: root.text;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        color: root.active ? Theme.bg : Theme.text-1;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Text field with an icon and a clear button.
component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> font-size: 14px;
    callback edited(string);
    callback accepted(string);
    callback escape();
    public function focus-input() { input.focus(); }
    height: 40px;
    border-radius: self.height / 2;
    background: input.has-focus ? Theme.surface-2 : Theme.hover;
    border-width: 1px;
    border-color: input.has-focus ? Theme.line-2 : transparent;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { name: "search"; size: 18px; ink: input.has-focus ? Theme.text-1 : Theme.text-3; }
        }
        Rectangle {
            horizontal-stretch: 1;
            FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Escape { root.escape(); return accept; }
                    reject
                }
                input := TextInput {
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    text <=> root.text;
                    font-size: root.font-size;
                    color: Theme.text-1;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.on-accent;
                    single-line: true;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
            }
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                text: root.placeholder;
                font-size: root.font-size;
                color: Theme.text-3;
                overflow: elide;
            }
        }
        if root.text != "": IconButton {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            icon: "close";
            icon-size: 14px;
            clicked => {
                root.text = "";
                root.edited("");
                input.focus();
            }
        }
    }
}

component QueueLine inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <bool> playing;
    in property <bool> playing-now;
    in property <bool> draggable;
    in property <bool> dragging;
    in property <length> drag-dy;
    callback clicked();
    callback drag-start();
    callback drag-move(length);
    callback drag-end(length);
    height: 56px;
    z: root.dragging ? 10 : 0;
    Rectangle {
        x: 8px;
        y: root.dragging ? root.drag-dy : 0px;
        width: root.width - 16px;
        height: root.height;
        border-radius: 8px;
        background: root.dragging ? Theme.surface-2 : root.playing ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
        drop-shadow-blur: root.dragging ? 16px : 0px;
        drop-shadow-color: #00000080;
        touch := TouchArea { mouse-cursor: pointer; double-clicked => { root.clicked(); } }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 12px;
            if root.playing: VerticalLayout { alignment: center; Equalizer { running: root.playing-now; } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.title; font-size: 14px; font-weight: 600; color: root.playing ? Theme.accent : Theme.text-1; overflow: elide; }
                if root.artist != "": Text { text: root.artist; font-size: 12px; color: Theme.text-2; overflow: elide; }
            }
            if root.draggable: Rectangle {
                width: 28px;
                Icon {
                    name: "grip";
                    size: 18px;
                    ink: grip.has-hover || root.dragging ? Theme.text-1 : Theme.text-3;
                }
                grip := TouchArea {
                    mouse-cursor: root.dragging ? grabbing : grab;
                    property <length> start-y;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            self.start-y = self.mouse-y;
                            root.drag-start();
                        } else if e.kind == PointerEventKind.up && root.dragging {
                            root.drag-end(self.mouse-y - self.start-y);
                        }
                    }
                    moved => {
                        if self.pressed && root.dragging { root.drag-move(self.mouse-y - self.start-y); }
                    }
                }
            }
        }
    }
}

component DeviceItem inherits Rectangle {
    in property <string> name;
    in property <string> kind;
    in property <bool> active;
    callback clicked();
    height: 52px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon { name: "devices"; size: 20px; ink: root.active ? Theme.accent : Theme.text-2; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text { text: root.name; font-size: 14px; font-weight: 600; color: root.active ? Theme.accent : Theme.text-1; overflow: elide; }
            Text { text: root.kind; font-size: 12px; color: Theme.text-3; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A theme in the settings: a tiny window drawn in its colours.
component ThemeSwatch inherits Rectangle {
    in property <ThemeCard> card;
    in property <bool> current;
    callback clicked();
    width: 148px;
    height: 112px;
    property <bool> hot: touch.has-hover;
    Rectangle {
        y: root.hot ? -3px : 0px;
        height: 80px;
        border-radius: Layout.radius;
        background: root.card.bg;
        border-width: root.current ? 2px : 1px;
        border-color: root.current ? Theme.accent : root.hot ? Theme.line-2 : Theme.line;
        clip: true;
        animate y { duration: Theme.normal; easing: ease-out; }
        animate border-color { duration: Theme.fast; }
        // sidebar strip, a card and a player bar
        Rectangle { x: 0; y: 0; width: 34px; height: parent.height; background: root.card.surface; opacity: 0.6; }
        Rectangle { x: 6px; y: 10px; width: 20px; height: 4px; border-radius: 2px; background: root.card.text; }
        Rectangle { x: 6px; y: 20px; width: 16px; height: 3px; border-radius: 2px; background: root.card.muted; }
        Rectangle { x: 6px; y: 28px; width: 18px; height: 3px; border-radius: 2px; background: root.card.muted; }
        Rectangle { x: 44px; y: 10px; width: 40px; height: 34px; border-radius: 5px; background: root.card.surface; }
        Rectangle { x: 90px; y: 10px; width: 40px; height: 34px; border-radius: 5px; background: root.card.surface; }
        Rectangle { x: 44px; y: 52px; width: 50px; height: 4px; border-radius: 2px; background: root.card.text; }
        Rectangle { x: 44px; y: 61px; width: 34px; height: 3px; border-radius: 2px; background: root.card.muted; }
        Rectangle {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: root.card.accent;
        }
        if root.current: Rectangle {
            x: parent.width - self.width - 8px;
            y: 8px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.accent;
            Icon { name: "check"; size: 12px; ink: Theme.on-accent; }
        }
    }
    HorizontalLayout {
        y: 86px;
        height: 22px;
        spacing: 6px;
        Text {
            text: root.card.name;
            font-size: 13px;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Theme.text-1 : Theme.text-2;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.card.custom: Rectangle {
            width: 36px;
            height: 18px;
            y: 2px;
            border-radius: 9px;
            background: Theme.surface-2;
            Text { text: "своя"; font-size: 10px; color: Theme.text-3; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    padding-bottom: 24px;
    Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.text-2; }
    Rectangle {
        border-radius: Layout.radius;
        background: Theme.surface;
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            @children
        }
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> last;
    min-height: 68px;
    if !root.last: Rectangle { x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: Theme.text-1; overflow: elide; }
            if root.hint != "": Text { text: root.hint; font-size: 12px; color: Theme.text-3; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            padding-top: 14px;
            padding-bottom: 14px;
            @children
        }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> hint;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { name: root.icon; size: 16px; ink: Theme.text-2; }
        }
        Text { text: root.text; font-size: 14px; color: Theme.text-1; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.hint; font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component MenuPanel inherits Rectangle {
    background: Theme.surface-2;
    border-radius: Layout.radius;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000099;
    drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 6px;
        @children
    }
}

// Sidebar card for a new version: one button downloads, verifies, installs and restarts.
component UpdateCard inherits Rectangle {
    in property <UpdateState> state;
    in property <string> version;
    in property <float> progress;
    in property <string> message;
    callback install();
    callback later();
    callback details();
    property <bool> busy: root.state == UpdateState.downloading || root.state == UpdateState.installing;
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Theme.slow; }
    border-radius: Layout.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.state == UpdateState.failed ? Theme.danger : Theme.line;
    vertical-stretch: 0;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Icon { name: "sparkle"; size: 16px; ink: Theme.accent; } }
            Text {
                text: root.state == UpdateState.downloading ? "Скачиваю " + root.version
                    : root.state == UpdateState.installing ? "Устанавливаю " + root.version
                    : root.state == UpdateState.failed ? "Не обновилось"
                    : "Новая версия " + root.version;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text-1;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !root.busy: Rectangle {
                width: 20px;
                Text { text: "×"; font-size: 16px; color: close.has-hover ? Theme.text-1 : Theme.text-3; }
                close := TouchArea { mouse-cursor: pointer; clicked => { root.later(); } }
            }
        }
        if root.state == UpdateState.failed: Text {
            text: root.message;
            font-size: 12px;
            color: Theme.text-3;
            wrap: word-wrap;
        }
        if root.busy: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.line;
            clip: true;
            Rectangle {
                x: 0;
                width: root.state == UpdateState.installing || root.progress < 0 ? parent.width : parent.width * root.progress;
                animate width { duration: Theme.fast; }
                border-radius: 2px;
                background: Theme.accent;
            }
        }
        if !root.busy: HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.state == UpdateState.failed ? "Повторить" : "Обновить";
                kind: ButtonKind.primary;
                horizontal-stretch: 1;
                clicked => { root.install(); }
            }
            Button { text: "Что нового"; kind: ButtonKind.ghost; clicked => { root.details(); } }
        }
    }
}

component StepLine inherits HorizontalLayout {
    in property <int> status; // 0 todo, 1 active, 2 done
    in property <string> text;
    spacing: 12px;
    alignment: start;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.status == 2 ? Theme.accent : transparent;
        border-width: root.status == 2 ? 0px : 2px;
        border-color: root.status == 1 ? Theme.accent : Theme.line-2;
        if root.status == 2: Text { text: "✓"; font-size: 12px; font-weight: 700; color: Theme.on-accent; }
    }
    Text {
        text: root.text;
        font-size: 15px;
        vertical-alignment: center;
        color: root.status == 0 ? Theme.text-3 : Theme.text-1;
    }
}

// Concentric grooves, slowly pulsing while we wait: a record without logos.
component Disc inherits Rectangle {
    in property <bool> spinning;
    property <float> t: self.spinning ? animation-tick() / 1ms : 0;
    property <length> d: min(self.width, self.height);
    Rectangle {
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: @radial-gradient(circle, #1C1C22 0%, #0B0B0E 70%);
    }
    for i in 14: Rectangle {
        width: root.d * (0.94 - i * 0.045);
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #FFFFFF10;
    }
    Rectangle {
        width: root.d * 0.34 * (root.spinning ? 1 + 0.03 * Math.sin((root.t / 400) * 1rad) : 1);
        height: self.width;
        border-radius: self.width / 2;
        background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.5) 100%);
    }
    Rectangle {
        width: root.d * 0.035;
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.bg;
    }
}

// ───────────── login ─────────────

component LoginScreen inherits Rectangle {
    in property <AuthView> view;
    in property <string> version;
    in property <int> waited-secs;
    callback login();
    callback cancel-login();
    callback reopen();

    property <bool> waiting: view == AuthView.waiting || view == AuthView.connecting;
    background: @radial-gradient(circle, #1A1420 0%, Theme.bg 60%);

    HorizontalLayout {
        padding: 48px;
        spacing: 48px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 20px;
            max-width: 560px;
            Logo { }
            Text {
                text: root.waiting ? "Войдите в браузере" : root.view == AuthView.reconnecting ? "Нет связи" : root.view == AuthView.checking ? "Подключаемся…" : "Ваша музыка, без лишнего";
                font-family: Fonts.display;
                font-weight: 700;
                font-size: 48px;
                color: Theme.text-1;
                wrap: word-wrap;
            }
            Text {
                text: root.waiting
                    ? "Страница входа Spotify уже открыта. Как только войдёте, Tonearm подключится сам."
                    : root.view == AuthView.reconnecting ? "Пробуем переподключиться к Spotify, это произойдёт само."
                    : root.view == AuthView.checking ? "Проверяем сохранённый вход."
                    : "Лёгкий нативный клиент: меньше 100 МБ памяти и мгновенный запуск. Вход через браузер, пароль вводится только на сайте Spotify. Нужен Premium.";
                font-size: 16px;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            if root.waiting: VerticalLayout {
                spacing: 12px;
                padding-top: 8px;
                StepLine { status: 2; text: "Страница входа открыта"; }
                StepLine { status: root.view == AuthView.waiting ? 1 : 2; text: "Ждём подтверждения · " + Fmt.clock(root.waited-secs * 1000); }
                StepLine { status: root.view == AuthView.connecting ? 1 : 0; text: "Подключение к сессии"; }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                padding-top: 12px;
                if root.view == AuthView.logged-out: Button {
                    text: "Войти через браузер";
                    kind: ButtonKind.primary;
                    height: 48px;
                    min-width: 220px;
                    clicked => { root.login(); }
                }
                if root.view == AuthView.waiting: Button { text: "Отмена"; clicked => { root.cancel-login(); } }
                if root.view == AuthView.waiting: Button { text: "Открыть снова"; kind: ButtonKind.ghost; icon: "link"; clicked => { root.reopen(); } }
            }
            Caption { text: "Tonearm " + root.version + " · неофициальный клиент, не связан со Spotify AB"; }
        }
        Disc {
            horizontal-stretch: 1;
            spinning: root.waiting || root.view == AuthView.checking || root.view == AuthView.reconnecting;
        }
    }
}

// ───────────── main window ─────────────

export component AppWindow inherits Window {
    // auth
    in property <AuthView> auth-view: AuthView.checking;
    in property <string> username;
    in property <string> version: "0.0.0";
    in property <int> waited-secs;
    // notices
    in property <string> notice;
    in property <bool> notice-is-error;
    in property <bool> offline;
    in property <int> retry-in-secs;
    // navigation
    in-out property <Page> page: Page.home;
    in property <string> date-label;
    in property <string> greeting: "Добрый день";
    // sidebar
    in property <[PlaylistEntry]> playlists;
    in property <int> liked-count;
    in property <string> active-uri;
    in property <string> context-uri;                 // what the queue plays (sidebar marker)
    // home
    in property <[TileData]> home-tiles;
    in property <[TileData]> recent-tiles;
    // collection page
    in property <int> page-kind;
    in property <string> page-title;
    in property <string> page-byline;
    in property <string> page-tracks-label;
    in property <string> page-length-label;
    in property <string> page-year-label;
    in property <image> page-image;
    in property <bool> page-has-image;
    in property <bool> page-loading;
    in property <string> page-error;
    in property <[TrackData]> page-tracks;
    in property <[TileData]> page-tiles;
    in-out property <string> page-filter;
    in-out property <int> page-sort;                  // 0 as listed, 1 title, 2 artist, 3 album, 4 duration
    in property <[string]> page-sort-labels: ["По порядку", "По названию", "По исполнителю", "По альбому", "По длительности"];
    in property <int> page-shown;                     // rows after the filter
    // search
    in-out property <string> search-query;
    in-out property <int> search-tab;                 // 0 all, 1 tracks, 2 albums, 3 artists, 4 playlists
    in property <[string]> search-tab-labels: ["Всё", "Треки", "Альбомы", "Исполнители", "Плейлисты"];
    in property <[TrackData]> search-tracks;
    in property <[TileData]> search-albums;
    in property <[TileData]> search-artists;
    in property <[TileData]> search-playlists;
    in property <TileData> search-best;
    in property <bool> search-has-best;
    in property <string> search-status: "Найдите трек, альбом, исполнителя или вставьте ссылку";
    in property <bool> search-status-error;
    in property <string> search-hint;
    in property <bool> search-more;
    in property <bool> search-loading-more;
    // player
    in property <PlayView> play-view: PlayView.stopped;
    in property <string> track-title;
    in property <string> track-artists;
    in property <string> track-context;
    in property <image> track-image;
    in property <bool> track-has-image;
    in property <image> track-backdrop;               // tiny copy of the cover; scaled up it is a blur
    in property <int> position-ms;
    in property <int> duration-ms;
    in-out property <int> volume-level: 8;
    in property <bool> resume-pending;                // last session's track, not loaded yet
    // queue
    in-out property <bool> queue-open;
    in property <[QueueRow]> queue-items;
    in property <string> queue-context;
    in property <bool> shuffle-on;
    in property <int> repeat-mode;                    // 0 off, 1 all, 2 one
    // lyrics
    in-out property <bool> lyrics-open;
    in property <[LyricRow]> lyrics;
    in property <int> lyrics-index: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status;               // "" shown, else "Загружаем…" / "Текста нет"
    in property <string> lyrics-provider;
    // quick jump (Ctrl+K)
    in-out property <bool> palette-open;
    in-out property <string> palette-query;
    in property <[PaletteRow]> palette-items;
    in-out property <int> palette-index;
    // stats
    in property <string> stats-minutes;
    in property <string> stats-plays;
    in property <string> stats-artists-count;
    in property <[StatRow]> stats-tracks;
    in property <[StatRow]> stats-artists;
    in property <[TrackData]> history-tracks;
    // Spotify Connect: "" plays here, otherwise the remote device's name
    in property <string> remote-name;
    in property <[DeviceRow]> devices;
    in property <bool> devices-loading;
    // settings
    in-out property <int> set-bitrate: 2;             // 96 | 160 | 320
    in-out property <int> set-normalisation;
    in-out property <int> set-gapless: 1;
    in-out property <int> set-notifications: 1;
    // Themes: built-in and from the themes folder.
    in property <[ThemeCard]> themes;
    in property <string> theme-id;
    in property <string> theme-errors;
    callback theme-picked(string);
    // Player bar: open the playing track's album (false) or artist (true).
    callback open-playing(bool);
    callback theme-open-folder();
    callback theme-new();
    callback theme-reload();
    in-out property <string> set-device;
    in-out property <int> set-cache: 2;               // 128 | 256 | 512 | 1024 MB
    in-out property <int> set-engine;                 // 0 built-in librespot, 1 Spotify Soloist
    in property <string> soloist-status: "Выключен";
    in property <string> soloist-detail;
    in property <bool> soloist-need-key;
    in property <bool> soloist-can-retry;
    in property <[string]> audio-devices;
    in property <int> cache-used-mb;
    // right-click menu over a track row
    property <int> menu-source;                       // 0 page, 1 search, 2 history
    property <int> menu-index;
    property <length> menu-x;
    property <length> menu-y;
    // queue drag and drop
    property <int> drag-index: -1;
    property <length> drag-dy;
    property <bool> playing-now: root.play-view == PlayView.playing;
    in-out property <length> coll-scroll;             // collection list scroll (header collapses)

    callback login();
    callback cancel-login();
    callback reopen-login();
    callback logout();
    callback dismiss-notice();
    callback retry-now();
    callback open-liked();
    callback open(int /* kind */, string /* uri */);
    callback play-collection(int /* kind */, string /* uri */);
    callback open-byline();
    callback play-row(int);
    callback play-page();
    callback toggle-play();
    callback seek(float);
    // Time under the pointer while the progress bar is dragged.
    property <int> scrub-ms: -1;
    callback volume-changed(int);
    callback back();
    callback search-edited(string);
    callback search-accepted(string);
    callback search-tab-changed(int);
    callback search-load-more();
    callback search-play(int);
    callback play-shuffled();
    callback next();
    callback prev();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback queue-jump(int);
    callback queue-clear();
    callback queue-move(int /* from */, int /* to */);
    // action: 0 queue, 1 go to artist, 2 go to album, 3 like, 4 radio
    callback row-action(int /* source */, int /* index */, int /* action */);
    callback radio-current();
    callback lyrics-opened();
    callback palette-opened();
    callback palette-edited(string);
    callback palette-activate(int);
    callback page-filter-edited(string);
    callback page-sort-changed(int);
    callback stats-opened();
    callback history-play(int);
    callback refresh-devices();
    callback settings-changed();
    callback soloist-get-key();
    callback soloist-key-entered(string);
    callback soloist-retry();
    callback clear-cache();
    callback refresh-audio-devices();
    callback pick-device(string /* id, "" = this computer */);

    // Updates (GitHub Releases, signed files).
    in property <UpdateState> update-state: UpdateState.idle;
    in property <string> update-version;
    in property <float> update-progress; // 0..1, < 0 = size unknown
    in property <string> update-message;
    // A new version is known (the error state keeps it so "Повторить" works).
    in property <bool> update-known;
    in-out property <bool> update-hidden;
    in-out property <int> set-update-check: 1;
    callback update-install();
    callback update-check();
    callback update-open-page();

    function seek-relative(delta-ms: int) {
        if self.duration-ms > 0 {
            self.seek(max(0, min(1, (self.position-ms + delta-ms) / self.duration-ms)));
        }
    }

    public function show-devices() {
        device-menu.show();
    }

    public function show-row-menu(source: int, index: int, x: length, y: length) {
        self.menu-source = source;
        self.menu-index = index;
        self.menu-x = min(x, self.width - 250px);
        self.menu-y = min(y, self.height - 230px);
        row-menu.show();
    }

    public function open-palette() {
        self.palette-open = true;
        self.palette-query = "";
        self.palette-index = 0;
        self.palette-opened();
    }

    function toggle-lyrics() {
        self.lyrics-open = !self.lyrics-open;
        if self.lyrics-open { self.lyrics-opened(); }
    }

    device-menu := PopupWindow {
        x: root.width - 310px;
        y: root.height - Layout.bar-height - self.height - 8px;
        width: 300px;
        MenuPanel {
            HorizontalLayout {
                height: 36px;
                padding-left: 10px;
                Text {
                    text: root.devices-loading ? "Ищем устройства…" : "Где играть";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-2;
                    vertical-alignment: center;
                }
            }
            DeviceItem {
                name: "Этот компьютер";
                kind: "Tonearm";
                active: root.remote-name == "";
                clicked => { root.pick-device(""); }
            }
            for d in root.devices: DeviceItem {
                name: d.name;
                kind: d.kind;
                active: root.remote-name != "" && d.active;
                clicked => { root.pick-device(d.id); }
            }
            if root.devices.length == 0 && !root.devices-loading: HorizontalLayout {
                padding: 10px;
                Text {
                    text: "Других устройств нет. Откройте Spotify на телефоне или колонке в той же сети.";
                    font-size: 12px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
            }
        }
    }

    row-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 240px;
        MenuPanel {
            MenuItem { icon: "queue"; text: "В очередь"; clicked => { root.row-action(root.menu-source, root.menu-index, 0); } }
            MenuItem { icon: "radio"; text: "Радио по треку"; clicked => { root.row-action(root.menu-source, root.menu-index, 4); } }
            MenuItem {
                icon: "heart";
                text: root.menu-source == 0 && root.page-kind == 0 ? "Убрать из любимых" : "В любимые";
                clicked => { root.row-action(root.menu-source, root.menu-index, 3); }
            }
            Rectangle { height: 1px; background: Theme.line; }
            MenuItem { icon: "user"; text: "К исполнителю"; clicked => { root.row-action(root.menu-source, root.menu-index, 1); } }
            MenuItem { icon: "library"; text: "К альбому"; clicked => { root.row-action(root.menu-source, root.menu-index, 2); } }
        }
    }

    title: "Tonearm";
    icon: @image-url("../../../assets/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: Fonts.text;
    default-font-size: 14px;

    changed page => {
        if self.page != Page.search { keys.focus(); }
        if self.page == Page.settings { root.refresh-audio-devices(); }
        if self.page == Page.stats { root.stats-opened(); }
        self.lyrics-open = false;
    }
    changed active-uri => { self.coll-scroll = 0; }
    changed palette-open => {
        if !self.palette-open { keys.focus(); }
    }
    keys := FocusScope {
        width: root.width;
        height: root.height;
        init => { self.focus(); }
        key-pressed(e) => {
            if root.auth-view != AuthView.logged-in { return reject; }
            if e.modifiers.control && (e.text == "k" || e.text == "K" || e.text == "л" || e.text == "Л") {
                root.open-palette();
                return accept;
            }
            if e.text == " " { root.toggle-play(); return accept; }
            if e.text == "q" || e.text == "Q" || e.text == "й" || e.text == "Й" {
                root.queue-open = !root.queue-open;
                return accept;
            }
            if e.text == "l" || e.text == "L" || e.text == "д" || e.text == "Д" {
                root.toggle-lyrics();
                return accept;
            }
            if e.text == "/" || (e.modifiers.control && (e.text == "f" || e.text == "а")) {
                root.page = Page.search;
                return accept;
            }
            if e.text == Key.RightArrow {
                if e.modifiers.control { root.next(); } else { root.seek-relative(5000); }
                return accept;
            }
            if e.text == Key.LeftArrow {
                if e.modifiers.control { root.prev(); } else { root.seek-relative(-5000); }
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.DownArrow {
                root.volume-level = max(0, min(12, root.volume-level + (e.text == Key.UpArrow ? 1 : -1)));
                root.volume-changed(root.volume-level);
                return accept;
            }
            if e.text == Key.Escape {
                if root.lyrics-open { root.lyrics-open = false; return accept; }
                if root.page == Page.collection { root.back(); return accept; }
            }
            reject
        }
        if root.auth-view != AuthView.logged-in: LoginScreen {
            width: root.width;
            height: root.height;
            view: root.auth-view;
            version: root.version;
            waited-secs: root.waited-secs;
            login => { root.login(); }
            cancel-login => { root.cancel-login(); }
            reopen => { root.reopen-login(); }
        }

        if root.auth-view == AuthView.logged-in: VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // ── sidebar
                Rectangle {
                    width: Layout.sidebar-width;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            height: 52px;
                            padding-left: 8px;
                            Logo { }
                        }
                        // quick jump
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: qj.has-hover ? Theme.line-2 : Theme.hover;
                            animate background { duration: Theme.fast; }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout { alignment: center; Icon { name: "search"; size: 16px; ink: Theme.text-2; } }
                                Text { text: "Перейти…"; font-size: 13px; color: Theme.text-2; vertical-alignment: center; horizontal-stretch: 1; }
                                Rectangle {
                                    width: kt.preferred-width + 12px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5px;
                                    background: Theme.surface-2;
                                    kt := Text { text: "Ctrl K"; font-size: 11px; color: Theme.text-3; }
                                }
                            }
                            qj := TouchArea { mouse-cursor: pointer; clicked => { root.open-palette(); } }
                        }
                        Rectangle { height: 8px; }
                        NavItem { icon: "home"; label: "Главная"; active: root.page == Page.home; clicked => { root.page = Page.home; } }
                        NavItem { icon: "search"; label: "Поиск"; active: root.page == Page.search; clicked => { root.page = Page.search; } }
                        NavItem { icon: "library"; label: "Медиатека"; active: root.page == Page.library || root.page == Page.collection; clicked => { root.page = Page.library; } }
                        NavItem { icon: "stats"; label: "Статистика"; active: root.page == Page.stats; clicked => { root.page = Page.stats; } }
                        Rectangle { height: 12px; }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            height: 40px;
                            padding-left: 8px;
                            Text { text: "Плейлисты"; font-size: 13px; font-weight: 600; color: Theme.text-2; vertical-alignment: center; }
                        }
                        SidebarRow {
                            liked: true;
                            name: "Любимые треки";
                            sub: root.liked-count + " треков";
                            active: root.active-uri == "liked" && root.page == Page.collection;
                            playing: root.context-uri == "liked";
                            clicked => { root.open-liked(); }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for p in root.playlists: SidebarRow {
                                name: p.name;
                                sub: p.owner != "" ? p.owner : p.count + " треков";
                                image: p.image;
                                has-image: p.has-image;
                                active: root.active-uri == p.uri && root.page == Page.collection;
                                playing: root.context-uri == p.uri;
                                clicked => { root.open(1, p.uri); }
                            }
                        }
                        if root.update-known && !root.update-hidden: UpdateCard {
                            state: root.update-state;
                            version: root.update-version;
                            progress: root.update-progress;
                            message: root.update-message;
                            install => { root.update-install(); }
                            later => { root.update-hidden = true; }
                            details => { root.update-open-page(); }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            height: 52px;
                            padding-left: 8px;
                            spacing: 10px;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 15px;
                                background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent.darker(0.6) 100%);
                                animate background { duration: Theme.slow; }
                                Text {
                                    text: root.username != "" ? "♪" : "";
                                    font-size: 14px;
                                    color: Theme.on-accent;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text { text: root.username; font-size: 13px; color: Theme.text-1; overflow: elide; }
                                Text {
                                    text: root.offline ? "Переподключение…" : "Premium";
                                    font-size: 11px;
                                    color: root.offline ? Theme.danger : Theme.text-3;
                                }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: "settings";
                                active: root.page == Page.settings;
                                clicked => { root.page = Page.settings; }
                            }
                        }
                    }
                }

                // ── content
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    // tint from the open page's cover (or the playing track on home)
                    Rectangle {
                        height: 340px;
                        y: 0;
                        background: @linear-gradient(180deg, (root.page == Page.collection ? Theme.page-accent : Theme.accent).with-alpha(root.page == Page.collection ? 0.42 : root.page == Page.home ? 0.22 : 0.0) 0%, Theme.bg.with-alpha(0) 100%);
                        animate background { duration: Theme.slow; }
                    }

                    if root.page == Page.home: PageIn {
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x;
                                padding-top: 28px;
                                padding-bottom: 32px;
                                spacing: 28px;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: root.greeting; font-family: Fonts.display; font-weight: 700; font-size: 34px; color: Theme.text-1; }
                                    Caption { text: root.date-label; font-size: 13px; }
                                }
                                // quick access: Liked + first playlists, two columns
                                Rectangle {
                                    property <int> cols: self.width > 900px ? 3 : 2;
                                    property <int> count: min(root.playlists.length + 1, cols * 2);
                                    property <length> cw: (self.width - (cols - 1) * 12px) / cols;
                                    height: Math.ceil(count / cols) * 72px - 12px;
                                    QuickCard {
                                        x: 0;
                                        y: 0;
                                        width: parent.cw;
                                        liked: true;
                                        entry: { name: "Любимые треки" };
                                        active: root.context-uri == "liked";
                                        clicked => { root.open-liked(); }
                                        play => { root.play-collection(0, "liked"); }
                                    }
                                    for p[i] in root.playlists: QuickCard {
                                        visible: i + 1 < parent.count;
                                        index: i + 1;
                                        x: Math.mod(i + 1, parent.cols) * (parent.cw + 12px);
                                        y: Math.floor((i + 1) / parent.cols) * 72px;
                                        width: parent.cw;
                                        entry: p;
                                        active: root.context-uri == p.uri;
                                        clicked => { root.open(1, p.uri); }
                                        play => { root.play-collection(1, p.uri); }
                                    }
                                }
                                // now playing / continue
                                if root.track-title != "": Rectangle {
                                    height: 200px;
                                    border-radius: 14px;
                                    clip: true;
                                    background: Theme.surface;
                                    if root.track-has-image: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.track-backdrop;
                                        image-fit: cover;
                                        image-rendering: smooth;
                                        opacity: 0.55;
                                    }
                                    Rectangle {
                                        background: @linear-gradient(90deg, #000000A0 0%, #00000040 100%);
                                    }
                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 24px;
                                        Cover {
                                            width: 160px;
                                            height: 160px;
                                            radius: 8px;
                                            source: root.track-image;
                                            loaded: root.track-has-image;
                                            drop-shadow-blur: 24px;
                                            drop-shadow-color: #00000080;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 8px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: root.resume-pending ? "Продолжить с того же места" : root.play-view == PlayView.playing ? "Сейчас играет" : "На паузе";
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: #FFFFFFB0;
                                            }
                                            Text {
                                                text: root.track-title;
                                                font-family: Fonts.display;
                                                font-weight: 700;
                                                font-size: 34px;
                                                color: #FFFFFF;
                                                opacity: hero-title-t.has-hover ? 0.85 : 1;
                                                overflow: elide;
                                                hero-title-t := TouchArea { mouse-cursor: pointer; clicked => { root.open-playing(false); } }
                                            }
                                            Text {
                                                text: root.track-artists;
                                                font-size: 15px;
                                                color: hero-artist-t.has-hover ? #FFFFFF : #FFFFFFC0;
                                                overflow: elide;
                                                hero-artist-t := TouchArea { mouse-cursor: pointer; clicked => { root.open-playing(true); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 10px;
                                                alignment: start;
                                                padding-top: 8px;
                                                PlayButton {
                                                    size: 48px;
                                                    playing: root.play-view == PlayView.playing || root.play-view == PlayView.loading;
                                                    clicked => { root.toggle-play(); }
                                                }
                                                Button { y: 5px; text: "Радио"; icon: "radio"; clicked => { root.radio-current(); } }
                                                Button { y: 5px; text: "Текст"; icon: "lyrics"; clicked => { root.toggle-lyrics(); } }
                                            }
                                        }
                                    }
                                }
                                if root.recent-tiles.length > 0: VerticalLayout {
                                    spacing: 14px;
                                    Heading { text: "Недавно слушали"; }
                                    TileGrid {
                                        tiles: root.recent-tiles;
                                        limit: self.cols;
                                        open(k, u) => { root.open(k, u); }
                                        play(k, u) => { root.play-collection(k, u); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 14px;
                                    Heading { text: root.home-tiles.length > 0 && root.home-tiles[0].kind == 2 ? "Альбомы" : "Ваши плейлисты"; }
                                    if root.home-tiles.length == 0: Text { text: "Загружаем медиатеку…"; color: Theme.text-3; }
                                    TileGrid {
                                        tiles: root.home-tiles;
                                        limit: self.cols * 2;
                                        open(k, u) => { root.open(k, u); }
                                        play(k, u) => { root.play-collection(k, u); }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.search: PageIn {
                        VerticalLayout {
                            padding-top: 24px;
                            HorizontalLayout {
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x;
                                spacing: 16px;
                                search-field := SearchField {
                                    height: 48px;
                                    max-width: 640px;
                                    font-size: 16px;
                                    text <=> root.search-query;
                                    placeholder: "Трек, альбом, исполнитель или ссылка open.spotify.com";
                                    init => { self.focus-input(); }
                                    edited(t) => { root.search-edited(t); }
                                    accepted(t) => { root.search-accepted(t); }
                                    escape => { root.search-query = ""; root.search-edited(""); }
                                }
                                if root.search-hint != "": Text {
                                    text: root.search-hint;
                                    font-size: 13px;
                                    color: Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                padding-left: Layout.page-x;
                                padding-top: 16px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                alignment: start;
                                for label[i] in root.search-tab-labels: Chip {
                                    text: label;
                                    active: i == root.search-tab;
                                    clicked => { root.search-tab = i; root.search-tab-changed(i); }
                                }
                            }

                            if root.search-status != "": VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 12px;
                                Icon { name: root.search-status-error ? "close" : "search"; size: 40px; ink: Theme.text-3; }
                                Text {
                                    text: root.search-status;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    color: root.search-status-error ? Theme.danger : Theme.text-2;
                                    wrap: word-wrap;
                                }
                            }

                            if root.search-tab == 0 && root.search-status == "": ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    padding-bottom: 32px;
                                    spacing: 28px;
                                    HorizontalLayout {
                                        padding-left: Layout.page-x;
                                        padding-right: Layout.page-x;
                                        padding-top: 12px;
                                        spacing: 24px;
                                        if root.search-has-best: VerticalLayout {
                                            width: 380px;
                                            spacing: 12px;
                                            Heading { text: "Лучший результат"; }
                                            Rectangle {
                                                height: 230px;
                                                border-radius: Layout.radius;
                                                background: best-touch.has-hover ? Theme.surface-2 : Theme.surface;
                                                animate background { duration: Theme.normal; }
                                                best-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open(root.search-best.kind, root.search-best.uri); } }
                                                VerticalLayout {
                                                    padding: 20px;
                                                    spacing: 14px;
                                                    Cover {
                                                        width: 100px;
                                                        height: 100px;
                                                        round: root.search-best.kind == 3;
                                                        source: root.search-best.image;
                                                        loaded: root.search-best.has-image;
                                                    }
                                                    Text {
                                                        text: root.search-best.title;
                                                        font-family: Fonts.display;
                                                        font-weight: 700;
                                                        font-size: 28px;
                                                        color: Theme.text-1;
                                                        overflow: elide;
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Rectangle {
                                                            width: kind-text.preferred-width + 16px;
                                                            height: 24px;
                                                            border-radius: 12px;
                                                            background: Theme.bg;
                                                            kind-text := Text {
                                                                text: root.search-best.kind == 2 ? "Альбом" : root.search-best.kind == 3 ? "Исполнитель" : "Плейлист";
                                                                font-size: 12px;
                                                                font-weight: 600;
                                                                color: Theme.text-1;
                                                            }
                                                        }
                                                        Text { text: root.search-best.subtitle; font-size: 13px; color: Theme.text-2; vertical-alignment: center; overflow: elide; }
                                                    }
                                                }
                                                if root.search-best.kind != 3: PlayButton {
                                                    x: parent.width - self.width - 20px;
                                                    y: best-touch.has-hover ? parent.height - self.height - 20px : parent.height - self.height - 8px;
                                                    opacity: best-touch.has-hover ? 1 : 0;
                                                    animate y, opacity { duration: Theme.normal; easing: ease-out; }
                                                    clicked => { root.play-collection(root.search-best.kind, root.search-best.uri); }
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            Heading { text: "Треки"; }
                                            VerticalLayout {
                                                for t[i] in root.search-tracks: TrackRow {
                                                    visible: i < 4;
                                                    height: i < 4 ? Layout.row-height + 4px : 0px;
                                                    show-image: true;
                                                    show-album: false;
                                                    code: t.code; title: t.title; artist: t.artist; album: t.album;
                                                    duration: t.duration; state: t.state;
                                                    image: t.image; has-image: t.has-image;
                                                    playing-now: root.playing-now;
                                                    play => { root.search-play(i); }
                                                    context-menu(p) => { root.show-row-menu(1, i, self.absolute-position.x + p.x, self.absolute-position.y + p.y); }
                                                }
                                            }
                                        }
                                    }
                                    if root.search-artists.length > 0: VerticalLayout {
                                        padding-left: Layout.page-x;
                                        padding-right: Layout.page-x;
                                        spacing: 14px;
                                        Heading { text: "Исполнители"; }
                                        TileGrid { tiles: root.search-artists; limit: self.cols; open(k, u) => { root.open(k, u); } }
                                    }
                                    if root.search-albums.length > 0: VerticalLayout {
                                        padding-left: Layout.page-x;
                                        padding-right: Layout.page-x;
                                        spacing: 14px;
                                        Heading { text: "Альбомы"; }
                                        TileGrid {
                                            tiles: root.search-albums;
                                            limit: self.cols;
                                            open(k, u) => { root.open(k, u); }
                                            play(k, u) => { root.play-collection(k, u); }
                                        }
                                    }
                                    if root.search-playlists.length > 0: VerticalLayout {
                                        padding-left: Layout.page-x;
                                        padding-right: Layout.page-x;
                                        spacing: 14px;
                                        Heading { text: "Плейлисты"; }
                                        TileGrid {
                                            tiles: root.search-playlists;
                                            limit: self.cols;
                                            open(k, u) => { root.open(k, u); }
                                            play(k, u) => { root.play-collection(k, u); }
                                        }
                                    }
                                }
                            }

                            if root.search-tab == 1 && root.search-status == "": ListView {
                                vertical-stretch: 1;
                                for t[i] in root.search-tracks: TrackRow {
                                    show-image: true;
                                    code: t.code; title: t.title; artist: t.artist; album: t.album;
                                    duration: t.duration; state: t.state;
                                    image: t.image; has-image: t.has-image;
                                    playing-now: root.playing-now;
                                    play => { root.search-play(i); }
                                    context-menu(p) => { root.show-row-menu(1, i, self.absolute-position.x + p.x, self.absolute-position.y + p.y); }
                                }
                            }
                            if root.search-tab >= 2 && root.search-status == "": ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    padding-left: Layout.page-x;
                                    padding-right: Layout.page-x;
                                    padding-top: 12px;
                                    TileGrid {
                                        tiles: root.search-tab == 2 ? root.search-albums : root.search-tab == 3 ? root.search-artists : root.search-playlists;
                                        open(k, u) => { root.open(k, u); }
                                        play(k, u) => { root.play-collection(k, u); }
                                    }
                                }
                            }
                            if root.search-tab > 0 && root.search-more && root.search-status == "": HorizontalLayout {
                                padding: 16px;
                                padding-left: Layout.page-x;
                                alignment: start;
                                Button {
                                    text: root.search-loading-more ? "Загружаем…" : "Показать ещё";
                                    clicked => { root.search-load-more(); }
                                }
                            }
                        }
                    }

                    if root.page == Page.library: PageIn {
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x;
                                padding-top: 28px;
                                padding-bottom: 32px;
                                spacing: 20px;
                                HorizontalLayout {
                                    Text { text: "Медиатека"; font-family: Fonts.display; font-weight: 700; font-size: 34px; color: Theme.text-1; horizontal-stretch: 1; }
                                    Caption { text: (root.playlists.length + 1) + " плейлистов"; vertical-alignment: center; font-size: 13px; }
                                }
                                Rectangle {
                                    property <int> cols: max(2, floor((self.width + 16px) / 196px));
                                    property <length> cell: (self.width - (cols - 1) * 16px) / cols;
                                    property <length> cell-h: cell + 52px;
                                    height: Math.ceil((root.playlists.length + 1) / cols) * (cell-h + 16px);
                                    TileView {
                                        x: 0;
                                        y: 0;
                                        width: parent.cell;
                                        height: parent.cell-h;
                                        tile: { kind: 0, title: "Любимые треки", subtitle: root.liked-count + " треков" };
                                        clicked => { root.open-liked(); }
                                        play => { root.play-collection(0, "liked"); }
                                        Rectangle {
                                            x: 12px;
                                            y: 12px;
                                            width: parent.width - 24px;
                                            height: self.width;
                                            border-radius: Layout.radius-s;
                                            background: @linear-gradient(135deg, #5B3CF0 0%, #C4B5FD 100%);
                                            Icon { name: "heart-fill"; size: 48px; ink: #FFFFFF; }
                                        }
                                    }
                                    for p[i] in root.playlists: TileView {
                                        x: Math.mod(i + 1, parent.cols) * (parent.cell + 16px);
                                        y: Math.floor((i + 1) / parent.cols) * (parent.cell-h + 16px);
                                        width: parent.cell;
                                        height: parent.cell-h;
                                        tile: { uri: p.uri, kind: 1, title: p.name, subtitle: p.owner != "" ? p.owner : p.count + " треков", image: p.image, has-image: p.has-image };
                                        clicked => { root.open(1, p.uri); }
                                        play => { root.play-collection(1, p.uri); }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.collection: PageIn {
                        coll := VerticalLayout {
                            // header: collapses while the list scrolls
                            property <bool> compact: root.coll-scroll < -24px;
                            Rectangle {
                                height: coll.compact ? 96px : 252px;
                                animate height { duration: Theme.normal; easing: ease-out; }
                                HorizontalLayout {
                                    padding-left: Layout.page-x;
                                    padding-right: Layout.page-x;
                                    padding-top: 20px;
                                    padding-bottom: 20px;
                                    spacing: 24px;
                                    if root.page-kind != 0: Cover {
                                        width: self.height;
                                        round: root.page-kind == 3;
                                        radius: 8px;
                                        source: root.page-image;
                                        loaded: root.page-has-image;
                                        drop-shadow-blur: 30px;
                                        drop-shadow-color: #00000090;
                                    }
                                    if root.page-kind == 0: Rectangle {
                                        width: self.height;
                                        border-radius: 8px;
                                        background: @linear-gradient(135deg, #5B3CF0 0%, #C4B5FD 100%);
                                        Icon { name: "heart-fill"; size: parent.height * 0.36; ink: #FFFFFF; }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: end;
                                        spacing: 8px;
                                        Text {
                                            text: root.page-kind == 0 ? "Плейлист" : root.page-kind == 2 ? "Альбом" : root.page-kind == 3 ? "Исполнитель" : "Плейлист";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text-1;
                                        }
                                        Text {
                                            text: root.page-title != "" ? root.page-title : " ";
                                            font-family: Fonts.display;
                                            font-weight: 700;
                                            font-size: coll.compact ? 26px : clamp((root.width - Layout.sidebar-width - (root.queue-open ? Layout.queue-width : 0px) - 300px) / 11, 30px, 64px);
                                            animate font-size { duration: Theme.normal; }
                                            color: Theme.text-1;
                                            overflow: elide;
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            if root.page-byline != "": Text {
                                                text: root.page-byline;
                                                font-size: 14px;
                                                font-weight: 600;
                                                color: root.page-kind == 2 && byline-touch.has-hover ? Theme.accent : Theme.text-1;
                                                byline-touch := TouchArea { enabled: root.page-kind == 2; mouse-cursor: pointer; clicked => { root.open-byline(); } }
                                            }
                                            Text {
                                                text: (root.page-year-label != "" ? " · " + root.page-year-label : "")
                                                    + (root.page-tracks-label != "" ? " · " + root.page-tracks-label + " треков" : "")
                                                    + (root.page-length-label != "" ? " · " + root.page-length-label : "");
                                                font-size: 14px;
                                                color: Theme.text-2;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                            // actions
                            HorizontalLayout {
                                height: 72px;
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x;
                                spacing: 12px;
                                IconButton { y: (parent.height - self.height) / 2; icon: "back"; clicked => { root.back(); } }
                                PlayButton {
                                    size: 52px;
                                    y: (parent.height - self.height) / 2;
                                    playing: root.context-uri == root.active-uri && root.play-view == PlayView.playing;
                                    clicked => {
                                        if root.context-uri == root.active-uri && root.play-view != PlayView.stopped { root.toggle-play(); } else { root.play-page(); }
                                    }
                                }
                                IconButton { y: (parent.height - self.height) / 2; width: 44px; height: 44px; icon: "shuffle"; icon-size: 24px; clicked => { root.play-shuffled(); } }
                                if root.page-loading: Rectangle {
                                    width: 90px;
                                    Text { text: "Загружаем…"; font-size: 13px; color: Theme.text-3; }
                                }
                                if root.page-error != "": Text {
                                    text: root.page-error;
                                    min-width: min(self.preferred-width, 280px);
                                    font-size: 13px;
                                    color: Theme.danger;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if root.page-kind != 3: SearchField {
                                    width: 240px;
                                    y: (parent.height - self.height) / 2;
                                    text <=> root.page-filter;
                                    placeholder: "Фильтр";
                                    edited(t) => { root.page-filter-edited(t); }
                                    escape => { root.page-filter = ""; root.page-filter-edited(""); }
                                }
                                if root.page-kind != 3: Rectangle {
                                    width: sort-row.preferred-width + 24px;
                                    height: 40px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 20px;
                                    background: sort-touch.has-hover ? Theme.hover : transparent;
                                    sort-row := HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text { text: root.page-sort-labels[root.page-sort]; font-size: 13px; color: Theme.text-2; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; Icon { name: "sort"; size: 16px; } }
                                    }
                                    sort-touch := TouchArea { mouse-cursor: pointer; clicked => { sort-menu.show(); } }
                                    sort-menu := PopupWindow {
                                        x: parent.width - 220px;
                                        y: parent.height + 4px;
                                        width: 220px;
                                        MenuPanel {
                                            for label[i] in root.page-sort-labels: MenuItem {
                                                text: label;
                                                hint: i == root.page-sort ? "✓" : "";
                                                clicked => { root.page-sort = i; root.page-sort-changed(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.page-kind != 3: HorizontalLayout {
                                height: 36px;
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x + 4px;
                                spacing: 14px;
                                Text { width: 28px; text: "#"; font-size: 12px; color: Theme.text-3; horizontal-alignment: center; vertical-alignment: center; }
                                Text { horizontal-stretch: 3; text: "Название"; font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
                                Text { horizontal-stretch: 2; text: "Альбом"; font-size: 12px; color: Theme.text-3; vertical-alignment: center; }
                                VerticalLayout { alignment: center; min-width: 48px; Icon { name: "clock"; size: 14px; ink: Theme.text-3; x: parent.width - self.width; } }
                            }
                            if root.page-kind != 3: Rectangle { height: 1px; background: Theme.line; x: Layout.page-x; width: parent.width - 2 * Layout.page-x; }
                            if root.page-kind != 3 && root.page-filter != "" && root.page-shown == 0 && !root.page-loading: Text {
                                height: 80px;
                                text: "Ничего не нашлось по «" + root.page-filter + "»";
                                font-size: 14px;
                                color: Theme.text-3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if root.page-kind != 3: ListView {
                                vertical-stretch: 1;
                                content-y <=> root.coll-scroll;
                                for t[i] in root.page-tracks: TrackRow {
                                    inset: Layout.page-x - 12px;
                                    code: t.code;
                                    title: t.title;
                                    artist: t.artist;
                                    album: t.album;
                                    show-album: root.page-kind != 2;
                                    duration: t.duration;
                                    state: t.state;
                                    playing-now: root.playing-now;
                                    play => { root.play-row(i); }
                                    context-menu(p) => { root.show-row-menu(0, i, self.absolute-position.x + p.x, self.absolute-position.y + p.y); }
                                }
                            }
                            if root.page-kind == 3: ScrollView {
                                vertical-stretch: 1;
                                content-y <=> root.coll-scroll;
                                VerticalLayout {
                                    alignment: start;
                                    padding-bottom: 32px;
                                    spacing: 12px;
                                    HorizontalLayout { padding-left: Layout.page-x; Heading { text: "Популярное"; } }
                                    VerticalLayout {
                                        padding-left: Layout.page-x - 8px;
                                        padding-right: Layout.page-x - 8px;
                                        for t[i] in root.page-tracks: TrackRow {
                                            code: t.code;
                                            title: t.title;
                                            artist: "";
                                            album: t.album;
                                            duration: t.duration;
                                            state: t.state;
                                            playing-now: root.playing-now;
                                            play => { root.play-row(i); }
                                            context-menu(p) => { root.show-row-menu(0, i, self.absolute-position.x + p.x, self.absolute-position.y + p.y); }
                                        }
                                    }
                                    HorizontalLayout { padding-left: Layout.page-x; padding-top: 16px; Heading { text: "Дискография"; } }
                                    HorizontalLayout {
                                        padding-left: Layout.page-x;
                                        padding-right: Layout.page-x;
                                        TileGrid {
                                            tiles: root.page-tiles;
                                            open(k, u) => { root.open(k, u); }
                                            play(k, u) => { root.play-collection(k, u); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.stats: PageIn {
                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                padding-left: Layout.page-x;
                                padding-right: Layout.page-x;
                                padding-top: 28px;
                                padding-bottom: 32px;
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Статистика"; font-family: Fonts.display; font-weight: 700; font-size: 34px; color: Theme.text-1; }
                                    Caption { text: "За последние 7 дней. Считается на этом компьютере, никуда не отправляется."; font-size: 13px; }
                                }
                                HorizontalLayout {
                                    spacing: 16px;
                                    for card in [
                                        { value: root.stats-minutes, label: "минут музыки" },
                                        { value: root.stats-plays, label: "прослушиваний" },
                                        { value: root.stats-artists-count, label: "исполнителей" },
                                    ]: Rectangle {
                                        height: 104px;
                                        border-radius: Layout.radius;
                                        background: Theme.surface;
                                        VerticalLayout {
                                            padding: 20px;
                                            spacing: 4px;
                                            alignment: center;
                                            Text { text: card.value; font-family: Fonts.display; font-weight: 700; font-size: 36px; color: Theme.text-1; }
                                            Text { text: card.label; font-size: 13px; color: Theme.text-2; }
                                        }
                                    }
                                }
                                if root.stats-tracks.length == 0: Text {
                                    text: "Пока пусто. Послушайте что-нибудь, и здесь появятся любимые треки и исполнители недели.";
                                    font-size: 14px;
                                    color: Theme.text-3;
                                    wrap: word-wrap;
                                }
                                if root.stats-tracks.length > 0: HorizontalLayout {
                                    spacing: 24px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;
                                        Heading { text: "Топ треков"; }
                                        for s[i] in root.stats-tracks: Rectangle {
                                            height: 56px;
                                            border-radius: 8px;
                                            background: st.has-hover ? Theme.hover : transparent;
                                            st := TouchArea { mouse-cursor: pointer; double-clicked => { root.history-play(-1 - i); } }
                                            // share bar
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * s.share;
                                                border-radius: 8px;
                                                background: Theme.accent.with-alpha(0.10);
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 12px;
                                                spacing: 12px;
                                                Text { width: 18px; text: i + 1; font-size: 13px; color: Theme.text-3; vertical-alignment: center; }
                                                Cover { width: 40px; height: 40px; y: 8px; radius: 4px; source: s.image; loaded: s.has-image; placeholder-icon: "play"; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text { text: s.title; font-size: 14px; font-weight: 600; color: Theme.text-1; overflow: elide; }
                                                    Text { text: s.subtitle; font-size: 12px; color: Theme.text-2; overflow: elide; }
                                                }
                                                Text { text: s.value; font-size: 13px; color: Theme.text-2; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 8px;
                                        alignment: start;
                                        Heading { text: "Топ исполнителей"; }
                                        for s[i] in root.stats-artists: Rectangle {
                                            height: 56px;
                                            border-radius: 8px;
                                            background: sa.has-hover ? Theme.hover : transparent;
                                            sa := TouchArea { mouse-cursor: pointer; clicked => { if s.uri != "" { root.open(3, s.uri); } } }
                                            Rectangle {
                                                x: 0;
                                                width: parent.width * s.share;
                                                border-radius: 8px;
                                                background: Theme.accent.with-alpha(0.10);
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 12px;
                                                spacing: 12px;
                                                Text { width: 18px; text: i + 1; font-size: 13px; color: Theme.text-3; vertical-alignment: center; }
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text { text: s.title; font-size: 14px; font-weight: 600; color: Theme.text-1; overflow: elide; }
                                                    Text { text: s.subtitle; font-size: 12px; color: Theme.text-2; overflow: elide; }
                                                }
                                                Text { text: s.value; font-size: 13px; color: Theme.text-2; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                                if root.history-tracks.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    Heading { text: "Недавно слушали"; }
                                    VerticalLayout {
                                        for t[i] in root.history-tracks: TrackRow {
                                            show-image: true;
                                            code: t.code;
                                            title: t.title;
                                            artist: t.artist;
                                            album: t.album;
                                            duration: t.duration;
                                            state: t.state;
                                            image: t.image;
                                            has-image: t.has-image;
                                            playing-now: root.playing-now;
                                            play => { root.history-play(i); }
                                            context-menu(p) => { root.show-row-menu(2, i, self.absolute-position.x + p.x, self.absolute-position.y + p.y); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.page == Page.settings: PageIn {
                        ScrollView {
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: start;
                                    max-width: 820px;
                                    horizontal-stretch: 1;
                                    padding-left: Layout.page-x;
                                    padding-right: Layout.page-x;
                                    padding-top: 28px;
                                    padding-bottom: 32px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        padding-bottom: 20px;
                                        Text { text: "Настройки"; font-family: Fonts.display; font-weight: 700; font-size: 34px; color: Theme.text-1; horizontal-stretch: 1; }
                                        Caption { text: "Сохраняются сразу"; vertical-alignment: center; font-size: 13px; }
                                    }
                                    SettingsGroup {
                                        title: "Звук";
                                        SettingRow {
                                            title: "Качество потока";
                                            hint: "Ogg Vorbis, кбит/с";
                                            Segmented { items: ["96", "160", "320"]; current <=> root.set-bitrate; changed => { root.settings-changed(); } }
                                        }
                                        SettingRow {
                                            title: "Нормализация громкости";
                                            hint: "Выравнивает громкость разных треков";
                                            VerticalLayout { alignment: center; Toggle { on <=> root.set-normalisation; changed => { root.settings-changed(); } } }
                                        }
                                        SettingRow {
                                            title: "Без пауз между треками";
                                            hint: "Следующий трек грузится заранее";
                                            VerticalLayout { alignment: center; Toggle { on <=> root.set-gapless; changed => { root.settings-changed(); } } }
                                        }
                                        SettingRow {
                                            title: "Аудиовыход";
                                            hint: "Применится со следующего трека";
                                            last: true;
                                            Rectangle {
                                                width: min(320px, dev-text.preferred-width + 52px);
                                                height: 38px;
                                                border-radius: 19px;
                                                background: out-touch.has-hover ? Theme.line-2 : Theme.hover;
                                                HorizontalLayout {
                                                    padding-left: 14px;
                                                    padding-right: 12px;
                                                    spacing: 8px;
                                                    dev-text := Text {
                                                        text: root.set-device == "" ? "Системный по умолчанию" : root.set-device;
                                                        font-size: 13px;
                                                        color: Theme.text-1;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        horizontal-stretch: 1;
                                                    }
                                                    VerticalLayout { alignment: center; Icon { name: "down"; size: 14px; } }
                                                }
                                                out-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.refresh-audio-devices();
                                                        output-menu.show();
                                                    }
                                                }
                                                output-menu := PopupWindow {
                                                    y: parent.height + 4px;
                                                    x: parent.width - 320px;
                                                    width: 320px;
                                                    MenuPanel {
                                                        MenuItem { text: "Системный по умолчанию"; clicked => { root.set-device = ""; root.settings-changed(); } }
                                                        for name in root.audio-devices: MenuItem { text: name; clicked => { root.set-device = name; root.settings-changed(); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Оформление";
                                        Rectangle {
                                            property <int> cols: max(1, floor((self.width - 40px + 12px) / 160px));
                                            height: ceil(root.themes.length / self.cols) * 124px + 24px;
                                            for t[i] in root.themes: ThemeSwatch {
                                                x: 20px + mod(i, parent.cols) * 160px;
                                                y: 16px + floor(i / parent.cols) * 124px;
                                                card: t;
                                                current: t.id == root.theme-id;
                                                clicked => { root.theme-picked(t.id); }
                                            }
                                        }
                                        SettingRow {
                                            title: "Свои темы";
                                            hint: root.theme-errors != "" ? "Не загрузились: " + root.theme-errors
                                                : "Файлы .toml в папке тем. Изменения в файле видны сразу";
                                            last: true;
                                            Button { text: "Создать из текущей"; icon: "plus"; clicked => { root.theme-new(); } }
                                            Button { text: "Папка тем"; kind: ButtonKind.ghost; clicked => { root.theme-open-folder(); } }
                                            IconButton { icon: "repeat"; clicked => { root.theme-reload(); } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Плеер";
                                        SettingRow {
                                            title: "Чем играть";
                                            hint: root.set-engine == 0 ? "Встроенный плеер (librespot)" : "Spotify Soloist: официальный плеер Spotify, нужен Premium";
                                            last: root.set-engine == 0;
                                            Segmented { items: ["Встроенный", "Soloist"]; current <=> root.set-engine; changed => { root.settings-changed(); } }
                                        }
                                        if root.set-engine == 1: SettingRow {
                                            title: "Soloist";
                                            hint: root.soloist-status + (root.soloist-detail != "" ? "\n" + root.soloist-detail : "");
                                            last: true;
                                            if root.soloist-need-key: Rectangle {
                                                width: 220px;
                                                height: 38px;
                                                border-radius: 19px;
                                                background: Theme.surface-2;
                                                border-width: 1px;
                                                border-color: key-input.has-focus ? Theme.line-2 : Theme.line;
                                                key-input := TextInput {
                                                    x: 14px;
                                                    width: parent.width - 28px;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    single-line: true;
                                                    input-type: password;
                                                    font-size: 13px;
                                                    color: Theme.text-1;
                                                    accepted => { root.soloist-key-entered(self.text); self.text = ""; }
                                                }
                                                if key-input.text == "": Text {
                                                    x: 14px;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    text: "или вставьте ключ, Enter";
                                                    font-size: 13px;
                                                    color: Theme.text-3;
                                                }
                                            }
                                            if root.soloist-need-key: Button { text: "Получить ключ"; icon: "link"; kind: ButtonKind.primary; clicked => { root.soloist-get-key(); } }
                                            if root.soloist-can-retry: Button { text: "Повторить"; clicked => { root.soloist-retry(); } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Уведомления";
                                        SettingRow {
                                            title: "Уведомление о новом треке";
                                            hint: "Когда окно в фоне";
                                            last: true;
                                            VerticalLayout { alignment: center; Toggle { on <=> root.set-notifications; changed => { root.settings-changed(); } } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Кэш обложек";
                                        SettingRow {
                                            title: root.cache-used-mb + " МБ из " + (root.set-cache == 0 ? 128 : root.set-cache == 1 ? 256 : root.set-cache == 2 ? 512 : 1024);
                                            hint: "Обложки хранятся на диске, чтобы не качать их заново";
                                            last: true;
                                            Segmented { items: ["128", "256", "512", "1024"]; current <=> root.set-cache; changed => { root.settings-changed(); } }
                                            Button { text: "Очистить"; kind: ButtonKind.ghost; clicked => { root.clear-cache(); } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Обновления";
                                        SettingRow {
                                            title: "Tonearm " + root.version;
                                            hint: root.update-state == UpdateState.checking ? "Проверяю…"
                                                : root.update-state == UpdateState.latest ? "Это последняя версия"
                                                : root.update-state == UpdateState.available ? "Доступна версия " + root.update-version
                                                : root.update-state == UpdateState.downloading ? "Скачиваю " + root.update-version + "…"
                                                : root.update-state == UpdateState.installing ? "Устанавливаю " + root.update-version + "…"
                                                : root.update-state == UpdateState.failed ? root.update-message
                                                : "Файлы обновлений подписаны, чужой файл не установится";
                                            if root.update-known && root.update-state != UpdateState.downloading && root.update-state != UpdateState.installing: Button {
                                                text: root.update-state == UpdateState.failed ? "Повторить" : "Обновить";
                                                kind: ButtonKind.primary;
                                                clicked => { root.update-install(); }
                                            }
                                            if !root.update-known: Button {
                                                text: "Проверить";
                                                kind: ButtonKind.ghost;
                                                clicked => { root.update-check(); }
                                            }
                                        }
                                        SettingRow {
                                            title: "Проверять автоматически";
                                            hint: "При запуске и раз в сутки";
                                            last: true;
                                            VerticalLayout { alignment: center; Toggle { on <=> root.set-update-check; changed => { root.settings-changed(); } } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Аккаунт";
                                        SettingRow {
                                            title: root.username;
                                            hint: "Вход хранится в зашифрованном виде, в config.toml его нет";
                                            last: true;
                                            Button { text: "Выйти"; icon: "logout"; kind: ButtonKind.danger; clicked => { root.logout(); } }
                                        }
                                    }
                                    SettingsGroup {
                                        title: "Горячие клавиши";
                                        for k[i] in [
                                            { key: "Пробел", what: "Пауза / продолжить" },
                                            { key: "Ctrl K", what: "Быстрый переход" },
                                            { key: "← →", what: "Перемотка на 5 секунд, с Ctrl: предыдущий / следующий трек" },
                                            { key: "↑ ↓", what: "Громкость" },
                                            { key: "Q", what: "Очередь" },
                                            { key: "L", what: "Текст песни" },
                                            { key: "/", what: "Поиск" },
                                        ]: HorizontalLayout {
                                            padding-left: 20px;
                                            padding-right: 20px;
                                            height: 40px;
                                            Text { text: k.what; font-size: 13px; color: Theme.text-2; vertical-alignment: center; horizontal-stretch: 1; }
                                            Rectangle {
                                                width: kk.preferred-width + 16px;
                                                height: 24px;
                                                y: 8px;
                                                border-radius: 5px;
                                                background: Theme.surface-2;
                                                kk := Text { text: k.key; font-size: 12px; color: Theme.text-1; }
                                            }
                                        }
                                    }
                                    Caption { text: "Tonearm " + root.version + " · неофициальный клиент, не связан со Spotify AB"; }
                                }
                            }
                        }
                    }

                    // ── lyrics overlay
                    if root.lyrics-open: Rectangle {
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        opacity: self.shown ? 1 : 0;
                        animate opacity { duration: 260ms; }
                        background: Theme.bg;
                        if root.track-has-image: Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.track-backdrop;
                            image-fit: cover;
                            image-rendering: smooth;
                            opacity: 0.45;
                        }
                        Rectangle { background: @linear-gradient(180deg, #00000066 0%, #000000B0 100%); }
                        TouchArea { }
                        VerticalLayout {
                            padding: 24px;
                            padding-left: 48px;
                            padding-right: 24px;
                            spacing: 16px;
                            HorizontalLayout {
                                spacing: 16px;
                                Cover { width: 56px; height: 56px; source: root.track-image; loaded: root.track-has-image; }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: root.track-title; font-size: 16px; font-weight: 600; color: #FFFFFF; overflow: elide; }
                                    Text { text: root.track-artists; font-size: 13px; color: #FFFFFFB0; overflow: elide; }
                                }
                                IconButton { icon: "close"; clicked => { root.lyrics-open = false; } }
                            }
                            if root.lyrics-status != "": Text {
                                vertical-stretch: 1;
                                text: root.lyrics-status;
                                font-family: Fonts.display;
                                font-weight: 700;
                                font-size: 28px;
                                color: #FFFFFF90;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            // synced: follows the song, the current line about a third from the top
                            if root.lyrics-status == "" && root.lyrics-synced: lyr := Flickable {
                                vertical-stretch: 1;
                                interactive: false;
                                property <length> line-h: 52px;
                                content-height: root.lyrics.length * self.line-h + 400px;
                                content-y: root.lyrics-index >= 0 ? min(0px, -(root.lyrics-index * self.line-h) + 120px) : 0px;
                                animate content-y { duration: 450ms; easing: ease-in-out; }
                                VerticalLayout {
                                    padding-top: 80px;
                                    alignment: start;
                                    for l[i] in root.lyrics: Text {
                                        height: lyr.line-h;
                                        text: l.text != "" ? l.text : "♪";
                                        font-family: Fonts.display;
                                        font-weight: 700;
                                        font-size: i == root.lyrics-index ? 34px : 28px;
                                        animate font-size, color { duration: 300ms; }
                                        color: i == root.lyrics-index ? #FFFFFF : i < root.lyrics-index ? #FFFFFF70 : #FFFFFF45;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            if root.lyrics-status == "" && !root.lyrics-synced: ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-top: 40px;
                                    padding-bottom: 40px;
                                    alignment: start;
                                    for l in root.lyrics: Text {
                                        height: 44px;
                                        text: l.text;
                                        font-family: Fonts.display;
                                        font-weight: 700;
                                        font-size: 24px;
                                        color: #FFFFFFE0;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            if root.lyrics-provider != "": Caption { text: "Текст: " + root.lyrics-provider; color: #FFFFFF70; }
                        }
                    }

                    // ── notice toast
                    if root.notice != "" || root.offline: Rectangle {
                        property <bool> shown: false;
                        init => { self.shown = true; }
                        x: (parent.width - self.width) / 2;
                        y: self.shown ? 16px : -60px;
                        animate y { duration: 320ms; easing: ease-out; }
                        width: min(parent.width - 48px, toast-row.preferred-width + 32px);
                        height: 48px;
                        border-radius: 24px;
                        background: root.offline || root.notice-is-error ? Theme.danger.with-alpha(0.2) : Theme.surface-2;
                        border-width: 1px;
                        border-color: root.offline || root.notice-is-error ? Theme.danger.with-alpha(0.35) : Theme.line-2;
                        drop-shadow-blur: 20px;
                        drop-shadow-color: #00000088;
                        toast-row := HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text {
                                text: root.offline ? "Нет связи со Spotify · повтор через " + Fmt.clock(root.retry-in-secs * 1000) : root.notice;
                                font-size: 13px;
                                color: Theme.text-1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.offline: Button { y: 5px; text: "Повторить"; clicked => { root.retry-now(); } }
                            if !root.offline: IconButton { y: 6px; icon: "close"; icon-size: 16px; clicked => { root.dismiss-notice(); } }
                        }
                    }

                }

                // ── queue panel (slides in)
                Rectangle {
                    width: root.queue-open ? Layout.queue-width : 0px;
                    animate width { duration: Theme.normal; easing: ease-out; }
                    clip: true;
                    background: Theme.sidebar;
                    if self.width > 0: VerticalLayout {
                        x: 0;
                        width: Layout.queue-width;
                        padding-top: 12px;
                        HorizontalLayout {
                            height: 48px;
                            padding-left: 20px;
                            padding-right: 12px;
                            Text { text: "Очередь"; font-family: Fonts.display; font-weight: 700; font-size: 18px; color: Theme.text-1; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { y: 6px; icon: "close"; clicked => { root.queue-open = false; } }
                        }
                        HorizontalLayout { padding-left: 20px; height: 32px; Caption { text: "Сейчас играет"; vertical-alignment: center; } }
                        if root.track-title != "": QueueLine {
                            title: root.track-title;
                            artist: root.track-artists;
                            playing: true;
                            playing-now: root.playing-now;
                        }
                        if root.track-title == "": HorizontalLayout { padding-left: 20px; height: 40px; Text { text: "Ничего не играет"; color: Theme.text-3; vertical-alignment: center; } }
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 16px;
                            height: 40px;
                            Caption {
                                text: root.queue-items.length > 0 && root.queue-items[0].manual ? "Далее в очереди" : root.queue-context != "" ? "Далее из «" + root.queue-context + "»" : "Далее";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if root.queue-items.length > 0 && root.queue-items[0].manual: Text {
                                text: "Очистить";
                                font-size: 12px;
                                color: clear-t.has-hover ? Theme.text-1 : Theme.text-2;
                                vertical-alignment: center;
                                clear-t := TouchArea { mouse-cursor: pointer; clicked => { root.queue-clear(); } }
                            }
                        }
                        queue-list := ListView {
                            vertical-stretch: 1;
                            for q[i] in root.queue-items: QueueLine {
                                title: q.title;
                                artist: q.artist;
                                draggable: true;
                                dragging: root.drag-index == i;
                                drag-dy: root.drag-dy;
                                clicked => { root.queue-jump(i); }
                                drag-start => { root.drag-index = i; root.drag-dy = 0; }
                                drag-move(dy) => { root.drag-dy = dy; }
                                drag-end(dy) => {
                                    let to = max(0, min(root.queue-items.length - 1, i + round(dy / 56px)));
                                    root.drag-index = -1;
                                    root.drag-dy = 0;
                                    if to != i { root.queue-move(i, to); }
                                }
                            }
                        }
                        if root.queue-items.length == 0: HorizontalLayout {
                            padding: 20px;
                            vertical-stretch: 1;
                            Text {
                                text: "Дальше пусто. Правый клик по треку → «В очередь» или «Радио по треку».";
                                font-size: 13px;
                                color: Theme.text-3;
                                wrap: word-wrap;
                                vertical-alignment: top;
                            }
                        }
                    }
                }
            }

            // ── player bar
            Rectangle {
                height: Layout.bar-height;
                background: Theme.surface;
                Rectangle { height: 1px; y: 0; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 20px;
                    spacing: 16px;
                    // now playing: a new track slides in (cover grows back, title rises)
                    now := HorizontalLayout {
                        width: 300px;
                        spacing: 14px;
                        property <bool> swap: false;
                        property <duration> settle: self.swap ? 0ms : 460ms;
                        property <string> title: root.track-title;
                        changed title => {
                            self.swap = true;
                            swap-timer.running = true;
                        }
                        swap-timer := Timer {
                            interval: 40ms;
                            running: false;
                            triggered => {
                                self.running = false;
                                now.swap = false;
                            }
                        }
                        Rectangle {
                            width: 56px;
                            Cover {
                                width: now.swap ? 40px : 56px;
                                height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                opacity: now.swap ? 0 : 1;
                                animate width { duration: now.settle; easing: cubic-bezier(0.2, 0.9, 0.3, 1.3); }
                                animate opacity { duration: now.settle; easing: ease-out; }
                                source: root.track-image;
                                loaded: root.track-has-image;
                                placeholder-icon: "play";
                                TouchArea { mouse-cursor: pointer; clicked => { root.toggle-lyrics(); } }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            opacity: now.swap ? 0 : 1;
                            animate opacity { duration: now.settle; easing: ease-out; }
                            VerticalLayout {
                                y: now.swap ? 10px : 0px;
                                animate y { duration: now.settle; easing: ease-out; }
                                height: parent.height;
                                alignment: center;
                                spacing: 3px;
                                // title → album, artist → artist page
                                Text {
                                    text: root.track-title != "" ? root.track-title : "Ничего не играет";
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: root.track-title == "" ? Theme.text-3 : title-t.has-hover ? Theme.accent : Theme.text-1;
                                    animate color { duration: Theme.fast; }
                                    overflow: elide;
                                    title-t := TouchArea {
                                        enabled: root.track-title != "";
                                        mouse-cursor: pointer;
                                        clicked => { root.open-playing(false); }
                                    }
                                }
                                Text {
                                    text: root.track-artists;
                                    font-size: 12px;
                                    color: artist-t.has-hover ? Theme.text-1 : Theme.text-2;
                                    animate color { duration: Theme.fast; }
                                    overflow: elide;
                                    artist-t := TouchArea {
                                        enabled: root.track-artists != "";
                                        mouse-cursor: pointer;
                                        clicked => { root.open-playing(true); }
                                    }
                                }
                                if root.remote-name != "": HorizontalLayout {
                                    spacing: 6px;
                                    Icon { name: "devices"; size: 12px; ink: Theme.accent; }
                                    Text { text: "Играет на «" + root.remote-name + "»"; font-size: 11px; color: Theme.accent; overflow: elide; }
                                }
                            }
                        }
                        if root.track-title != "": IconButton { y: (parent.height - self.height) / 2; icon: "radio"; icon-size: 18px; clicked => { root.radio-current(); } }
                    }
                    // transport + progress
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            IconButton { icon: "shuffle"; active: root.shuffle-on; clicked => { root.toggle-shuffle(); } }
                            IconButton { icon: "prev"; icon-size: 18px; clicked => { root.prev(); } }
                            PlayButton {
                                size: 40px;
                                fill: Theme.text-1;
                                ink: Theme.bg;
                                playing: root.play-view == PlayView.playing || root.play-view == PlayView.loading;
                                clicked => { root.toggle-play(); }
                            }
                            IconButton { icon: "next"; icon-size: 18px; clicked => { root.next(); } }
                            IconButton { icon: "repeat"; active: root.repeat-mode != 0; badge: root.repeat-mode == 2 ? "1" : ""; clicked => { root.cycle-repeat(); } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            max-width: 640px;
                            Text {
                                width: 40px;
                                text: Fmt.clock(root.scrub-ms >= 0 ? root.scrub-ms : root.position-ms);
                                font-family: Fonts.mono;
                                font-size: 11px;
                                color: Theme.text-3;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Slider {
                                horizontal-stretch: 1;
                                smooth: root.play-view == PlayView.playing;
                                value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
                                moving(v) => { root.scrub-ms = v * root.duration-ms; }
                                committed(v) => {
                                    root.scrub-ms = -1;
                                    root.seek(v);
                                }
                            }
                            Text {
                                width: 40px;
                                text: Fmt.clock(root.duration-ms);
                                font-family: Fonts.mono;
                                font-size: 11px;
                                color: Theme.text-3;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // right side
                    HorizontalLayout {
                        width: 300px;
                        alignment: end;
                        spacing: 4px;
                        IconButton { y: (parent.height - self.height) / 2; icon: "lyrics"; active: root.lyrics-open; clicked => { root.toggle-lyrics(); } }
                        IconButton { y: (parent.height - self.height) / 2; icon: "queue"; active: root.queue-open; clicked => { root.queue-open = !root.queue-open; } }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: "devices";
                            active: root.remote-name != "";
                            clicked => {
                                root.refresh-devices();
                                root.show-devices();
                            }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: root.volume-level == 0 ? "mute" : "volume";
                            property <int> before-mute: 8;
                            clicked => {
                                if root.volume-level > 0 { self.before-mute = root.volume-level; root.volume-level = 0; } else { root.volume-level = self.before-mute; }
                                root.volume-changed(root.volume-level);
                            }
                        }
                        Slider {
                            width: 110px;
                            y: (parent.height - self.height) / 2;
                            value: root.volume-level / 12;
                            committed(v) => {
                                root.volume-level = round(v * 12);
                                root.volume-changed(root.volume-level);
                            }
                            moving(v) => { root.volume-level = round(v * 12); }
                        }
                    }
                }
            }
        }

        // ── quick jump palette (Ctrl+K)
        if root.palette-open && root.auth-view == AuthView.logged-in: Rectangle {
            property <bool> shown: false;
            init => { self.shown = true; pal-input.focus(); }
            background: #00000080;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 160ms; }
            TouchArea { clicked => { root.palette-open = false; } }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.shown ? parent.height * 0.14 : parent.height * 0.14 - 16px;
                animate y { duration: 200ms; easing: ease-out; }
                width: min(620px, parent.width - 48px);
                height: pal-col.preferred-height;
                border-radius: 14px;
                background: Theme.surface-2;
                border-width: 1px;
                border-color: Theme.line-2;
                drop-shadow-blur: 40px;
                drop-shadow-color: #000000AA;
                drop-shadow-offset-y: 12px;
                TouchArea { }
                pal-col := VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        height: 52px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        VerticalLayout { alignment: center; Icon { name: "search"; size: 20px; ink: Theme.text-2; } }
                        Rectangle {
                            horizontal-stretch: 1;
                            FocusScope {
                                key-pressed(e) => {
                                    if e.text == Key.Escape { root.palette-open = false; return accept; }
                                    if e.text == Key.DownArrow { root.palette-index = Math.mod(root.palette-index + 1, max(1, root.palette-items.length)); return accept; }
                                    if e.text == Key.UpArrow { root.palette-index = Math.mod(root.palette-index - 1 + root.palette-items.length, max(1, root.palette-items.length)); return accept; }
                                    if e.text == Key.Return {
                                        if root.palette-items.length > 0 {
                                            root.palette-open = false;
                                            root.palette-activate(root.palette-index);
                                        }
                                        return accept;
                                    }
                                    reject
                                }
                                pal-input := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    text <=> root.palette-query;
                                    font-size: 17px;
                                    color: Theme.text-1;
                                    single-line: true;
                                    selection-background-color: Theme.accent;
                                    edited => { root.palette-index = 0; root.palette-edited(self.text); }
                                }
                            }
                            if root.palette-query == "": Text {
                                height: parent.height;
                                vertical-alignment: center;
                                text: "Плейлист, страница, команда или поиск…";
                                font-size: 17px;
                                color: Theme.text-3;
                            }
                        }
                        Rectangle {
                            width: esc.preferred-width + 12px;
                            height: 22px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 5px;
                            background: Theme.hover;
                            esc := Text { text: "Esc"; font-size: 11px; color: Theme.text-3; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    for item[i] in root.palette-items: Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: i == root.palette-index ? Theme.selected : transparent;
                        animate background { duration: 80ms; }
                        pt := TouchArea {
                            mouse-cursor: pointer;
                            moved => { root.palette-index = i; }
                            clicked => { root.palette-open = false; root.palette-activate(i); }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 14px;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                y: 8px;
                                border-radius: 6px;
                                background: item.kind == 5 ? @linear-gradient(135deg, #5B3CF0 0%, #C4B5FD 100%) : Theme.hover;
                                Icon { name: item.icon; size: 16px; ink: item.kind == 5 ? #FFFFFF : i == root.palette-index ? Theme.text-1 : Theme.text-2; }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 1px;
                                Text { text: item.title; font-size: 14px; color: Theme.text-1; overflow: elide; }
                                if item.subtitle != "": Text { text: item.subtitle; font-size: 12px; color: Theme.text-3; overflow: elide; }
                            }
                            if i == root.palette-index: Text { text: "↵"; font-size: 14px; color: Theme.text-3; vertical-alignment: center; }
                        }
                    }
                    if root.palette-items.length == 0: Text {
                        height: 56px;
                        text: "Ничего не нашлось";
                        color: Theme.text-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
