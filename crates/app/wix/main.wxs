<?xml version='1.0' encoding='windows-1252'?>
<!--
  Tonearm MSI (WiX v3, built by cargo-wix). From the workspace root on Windows:
      cargo install cargo-wix
      cargo wix crates\app\Cargo.toml (add the nocapture flag to see WiX output)
  The installer lands in target\wix\. Variables come from cargo-wix:
  Version, CargoTargetBinDir; sys.BUILDARCH is set by candle.
  Keep UpgradeCode forever: it lets a new MSI replace the old one.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Tonearm'
        UpgradeCode='464A48EC-0267-46AA-8DC1-D2E81773E05A'
        Manufacturer='Tonearm contributors'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Tonearm, a lightweight native music client (unofficial)'
            Manufacturer='Tonearm contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>
        <Icon Id='TonearmIco' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='TonearmIco'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/chelond/tonearm'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Tonearm'>
                    <Component Id='binary0' Guid='*'>
                        <File Id='exe0' Name='tonearm.exe' DiskId='1'
                            Source='$(var.CargoTargetBinDir)\tonearm.exe' KeyPath='yes'/>
                    </Component>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile' Name='LICENSE.txt' DiskId='1' Source='LICENSE' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='733BDFF5-474E-41A8-AC8E-A4524E572D74'>
                    <Shortcut Id='TonearmShortcut' Name='Tonearm'
                        Description='Lightweight native music client'
                        Target='[APPLICATIONFOLDER]tonearm.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='TonearmIco'/>
                    <RegistryValue Root='HKCU' Key='Software\Tonearm' Name='installed'
                        Type='integer' Value='1' KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature Id='Binaries' Title='Tonearm' Level='1' Absent='disallow'
            ConfigurableDirectory='APPLICATIONFOLDER' AllowAdvertise='no' Display='expand'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='License'/>
            <ComponentRef Id='StartMenuShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <UIRef Id='WixUI_InstallDir'/>
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <WixVariable Id='WixUILicenseRtf' Value='crates\app\wix\License.rtf'/>
    </Product>
</Wix>
